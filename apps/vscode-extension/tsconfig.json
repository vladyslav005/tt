{
    "compilerOptions": {
        "target": "ES2022",
        "noImplicitAny": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "noEmit": true,

        "esModuleInterop": true,
        "skipLibCheck": true,

        "types": [
            "node",
            "vscode"
        ]
    },

    "include": [
        "src"
    ],
    "exclude": [
        "src/webview"
    ]
}
